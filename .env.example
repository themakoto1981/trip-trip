# Copy this file to .env (which is git-ignored) and fill in your real key.
# Get a key at: https://platform.openai.com/api-keys
# This file itself is committed to the repo as a template; never put a
# real key in a file named .env.example.
OPENAI_API_KEY=

# Optional: override the default model (gpt-6.1-sol). See README.md for
# why gpt-6.1-sol is the default.
# GPT_REVIEW_MODEL=gpt-6.1-sol
